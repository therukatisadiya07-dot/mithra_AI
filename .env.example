# Shiftwise (Mithra_AI) Environment Variables

# Server Port
PORT=3000

# Super Admin Configuration
# The designated administrator account for Shiftwise platform oversight
SUPER_ADMIN_EMAIL="therukatisadiya07@gmail.com"
# Default administrative setup passphrase for initial boot (can be changed in admin settings)
SUPER_ADMIN_PASSWORD="ShiftwiseAdminSecure2026!"

# Session / JWT Secret for signing auth tokens
