# Demonstration Mode Flag (defaults to true for prototype)
DEMO_PAYMENTS_ENABLED="true"

# Optional external service credentials (when real SMS/Email/Storage providers are integrated)
# OTP_SMS_PROVIDER_API_KEY=""
# EMAIL_SMTP_URL=""
# CLOUD_STORAGE_BUCKET=""

# GEMINI_API_KEY: Automatically injected by AI Studio for smart recommendations/assistance
